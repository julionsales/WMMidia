# Copie para .env e preencha. NÃO versione o .env.
# Gere segredos com:  openssl rand -hex 32   (use apenas letras/números nas senhas do Mongo/Redis)

# --- Obrigatórios ---
SECRET_KEY=
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=monitor_app
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

# --- Banco ---
MONGO_DB=monitor_automotivo

# --- Acesso ---
# Endereço/porta onde o frontend fica disponível. 127.0.0.1 = apenas nesta máquina.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
# Origens extras autorizadas a chamar a API diretamente (ex.: Vite em desenvolvimento).
# Em produção o frontend usa o mesmo endereço (/api via proxy) e isto pode ficar vazio.
CORS_ORIGINS=
ACCESS_TOKEN_MINUTES=480
LOG_LEVEL=INFO

# --- Coleta de estoque ---
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_PAGES=30
# Sem total anunciado pelo site, coleta com menos de 50% dos ativos anteriores é tratada como parcial.
INVENTORY_MIN_RATIO=0.5
PLAYWRIGHT_ENABLED=true

# --- Instagram ---
INSTAGRAM_PROVIDER=instaloader
# Sessão de consulta OPCIONAL (conta da equipe, nunca a senha da empresa monitorada).
# Coloque o arquivo em ./secrets/instagram/ e informe o caminho dentro do container:
INSTAGRAM_SESSION_FILE=
INSTAGRAM_SESSION_USERNAME=
INSTAGRAM_POSTS_LIMIT=24
INSTAGRAM_RATE_LIMIT=2/m
INSTAGRAM_BLOCK_MINUTES=60
INSTAGRAM_FOLLOWERS_TOLERANCE_DAYS=3
INSTAGRAM_MIN_FREQUENCY_HOURS=6

# --- Tarefas ---
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_SECONDS=60
RUN_LEASE_MINUTES=45
SCHEDULER_TICK_SECONDS=60
